//----------------------------------------------------------
//	MicroBasic Microcode (c) 2025-... zpekic@hotmail.com
//  Compile with https://github.com/zpekic/MicroCodeCompiler
//----------------------------------------------------------
			.code 9, 80, microBasic_code.mif, microBasic_code.cgf, microBasic_code.coe, mb:microBasic_code.vhd, microBasic_code.hex, microBasic_code.bin, 10;
			.mapper 8, 16, microBasic_map.mif, microBasic_map.cgf, microBasic_map.coe, mb:microBasic_map.vhd, microBasic_map.hex, microBasic_map.bin, 2;
			.controller microBasic_control_unit.vhd, 4;
			//.symbol 9, 256, microBasic_sym.mif, microBasic_sym.cgf, microBasic_sym.coe, mb:microBasic_sym.vhd, microBasic_sym.hex, microBasic_sym.bin, 32;

// System interface signals
nBUSREQ			.valfield 1 values 0, 1 default 1;
nWR				.valfield 1 values 0, 1 default 1;
nRD				.valfield 1 values 0, 1 default 1;
// nBUSACK		consumed as condition
// A(15..0)		
// D(7..0)

seq_cond:		.if 5 values 
				true, 			// hard-code to 1
				ILCODEBYTE_BIT7,	// 
				CHAROUT_READY,	//  
				IL_A_VALID,	// value of IL program counter in valid range
				DBG_READY,		// high if tracer has processed the trace character
				MDR_EQU_DB,		
				nBUSACK,		// low if memory is ready for read/write		
				INLEND_MAX,		
				INLEND_MIN,		
				CHARIN_PRINTABLE,	// ASCII code in range 0x20 .. 0x7E		
				CHARIN_EQU_DB,		
				CHARIN_READY,		
				BP_IN_INPLINE,		
				SVP_IN_INPLINE,		
				MDR_IS_NUM,		// MDR contains ASCII 0..9
				MDR_IS_ALPHA,
				STACK_IS_FULL,
				STACK_IS_EMPTY,
				MDR_MATCHES_ILCODEBYTE,
				R_IS_ZERO,
				Y_ZERO,
				Y_SIGN,
				ALU_READY | LS_PARAMS_OK | LS_IN_RANGE,
				ALU_OVERFLOW | LS_PASSED_END,
				ALU_SIGN,
				AT_TAB,
				OFF_IS_ZERO,
				LEADING_ZERO,
				IS_RUNMODE,
				dummy29,
				dummy30,
				false			// hard-code to 0
				default true;
seq_then:	.then 9 values next, repeat, return, fork, @ default next;						// any label
seq_else:	.else 9 values next, repeat, return, fork, 0b000000..0b111111, @ default next;	// any value as it can be a trace char

// Direct byte, usually ASCII code
directByte	.valfield 8 values 0x00..0xFF default 0xFF;

// 16 bit temporary register
T			.regfield 4 values
				same,
				IL_PC,
				XQhere,
				from_vars,
				ExpStack,
				from_Y,
				codeByte,
				MDRx2,
				inc,
				dec,
				BP,
				Prog_start,
				PrgEnd,
				from_S,
				from_R
				default same;
				
// contains ASCII char for DEBUG UART transmit
DBGINDEX		.regfield 2 values 
				same,
				from_microcode,
				zero,
				crlf // shortcut to index 63 which should contain CR, LF, NULL sequence
				default same;		

// 10-bit IL program counter
IL_PC:			.regfield 3 values
				same,
				zero,
				inc,
				T,
				pc_plus_off6,
				pc_plus_off5,
				direct11,
				RetStack
				default same;

// 10-bit saved IL_PC
XQhere			.regfield 1 values
				same,
				T
				default same;
				
// 8-bit IL opcode (CPU "instruction register")
IL_OP:			.regfield 1 values
				same,
				from_interpreter
				default same;

RetStack		.regfield 2 values
				same,
				clear,
				pop,
				push_IL_PC_PLUS_1
				default same;

// 8-bit char to be output
CHAROUT:		.regfield 3 values
				same,
				from_interpreter, 
				from_microcode,
				from_charin,
				from_MDR,
				from_YtoAlpha,	// load ASCII code based on BCD character in Y top nibble	
				-,
				-		
				default same;

// 16-bit Memory Address Register
MAR:			.regfield 2 values
				same, 
				InlEnd,
				BP,
				T
				default same;
				
// 8-bit Memory Address Register
MDR:			.regfield 3 values
				same, 
				from_Bus,
				zero,
				CHARIN,
				ToUpper,
				from_SHi,
				from_SLo,
				-
				default same;

// 16-bit pointer to input buffer
InlEnd			.regfield 2 values
				same,
				InLine_start,
				inc,
				dec
				default same;

// 16-bit Basic pointer
BP				.regfield 3 values
				same,
				InLine_start,
				SvPt,
				inc,
				save,
				restore,
				T,
				LS
				default same;

// 16-bit saved basic pointer
SvPt			.regfield 2 values
				same,
				InLine_start,
				BP,
				-
				default same;
				
ExpStack		.regfield 3 values
				same,
				clear,
				startSwap,
				endSwap,
				push_TWord,
				push_TByte,
				pop2,
				pop1
				default same;
				
// flag to reset input character ready flag
gotChar			.valfield 1 values 
				0,
				1
				default 0;				

Vars			.regfield 2 values
				same,
				indexFromExpStack,
				T,
				-
				default same;				
								
// 16-bit ALU, with input regs R and S and output Y
alu				.regfield 5 values
				nop, 
				reset0,
				reset1,
				R_fromStack,
				S_fromStack,
				S_plus_R,
				S_minus_R,
				neg_R,
				S_mul_R,
				Yx16,
				bcd_start,
				bcd_next,
				div_start,
				div_shift,
				div_subset,
				div_end,
				Yx10_plus_MDR,
				Rx256_plus_MDR,
				S_fromT,
				R_fromT,
				S_fromLino,
				copy_setup,
				copy_next,
				ls_load,
				ls_check,
				-,
				-,
				-,
				-,
				-,
				-,
				-
				default nop;

// 16-bit Basic line number
Lino			.regfield 1 values
				same,
				T
				default same;

// 16-bit pointer to end of command / statement in input line (points to CR, BP is the start)
BE				.regfield 1 values
				same,
				T
				default same;

// 16-bit pointer to start of Basic statement (points to first byte of line number)
LS				.regfield 1 values
				same,
				T
				default same;
				
// 16-bit pointer to end of Basic statement (points to CR, LS is the start)
LE				.regfield 1 values
				same,
				T
				default same;
				
// 16-bit pointer to end of Basic program (points to last of two consecutive NULL chars)
PrgEnd			.regfield 1 values
				same,
				T
				default same;
				
// placeholder
dummy:			.valfield 2 values * default 0;
						
//	useful aliases, these are evaluated as simple text replacement of label with everything between .alias and ; 
NULL: 		.alias 0x00;
CTRL_C:		.alias 0x03;
ESC:		.alias 0x1b;
BEEP:		.alias 0x07;
BACKSPACE:	.alias 0x08;
TAB:		.alias 0x09;
LF:			.alias 0x0A;
CR:			.alias 0x0D;
//SPACE:		.alias 0x20;
//DQUOTE:		.alias 0x22;
clear:		.alias DBGINDEX <= zero, IL_PC <= zero, ExpStack <= clear, RetStack <= clear, alu <= reset0;
nop:		.alias if true then next;
goto:		.alias if false then next else;
noop:		.alias if true then next else next;
back:	    .alias if true then return else return;
traceString .alias trace(from_microcode), directByte =;
traceGoto	.alias trace(from_microcode), directByte = 30;
traceCall	.alias trace(from_microcode), directByte = 31;
traceLino	.alias trace(from_microcode), directByte = 52;
traceT		.alias trace(from_microcode), directByte = 53;
traceSDepth:.alias trace(from_microcode), directByte = 56;	// trace stack depth by indenting 0 to 8 spaces

// gosub definitions - this works because "jump" pushes return address to stack if both then/else are same
//dump_il:	.sub;
dump_input:	.sub;
trace:		.sub DBGINDEX;
outCRLF:	.sub;
outChar:	.sub CHAROUT;
WriteCore:	.sub MAR, MDR;
ReadCore:	.sub MAR;
skipSpaces: .sub;
pullRS:		.sub;
printDec:	.sub;
printDecR:	.sub;
delBasLine: .sub;
insLnBefore:.sub;
findBasLine:.sub T;
findPrgEnd: .sub T;
findNextCR:	.sub T;
write2Nulls:.sub T;
readCore16:	.sub T;
traceALU:	.sub;
traceY:		.sub;
traceBP:	.sub;

			.org 0;
//	First 4 microcode locations can't be used branch destinations
//	---------------------------------------------------------------------------
_reset:		nop;			// TODO: use these 4 microcycles for cold start intialization  

_reset1:	nop;

_reset2:	nop;

_reset3:	nop;

//	indicate availability and wait for start signal
//	---------------------------------------------------------------------------
ColdStart:	traceString 4;	// output "MicroBas" on debug UART
			write2Nulls(Prog_start);
WarmStart:	clear;
			BP <= InLine_start, SvPt <= InLine_start, InlEnd <= InLine_start, T <= from_R; 
			Lino <= T;
			XQhere <= T;
			T <= Prog_start;
			PrgEnd <= T;
			write2Nulls(BP);
			
fetch:		trace(crlf);
			traceString 51;								// trace Basic line number (in hex, for speed)
			traceString 2; 								// trace IL_PC and future opcode
			IL_OP <= from_interpreter, IL_PC <= inc;	// load opcode, advance IL_PC
			alu <= reset0, if IL_A_VALID then fork else INTERNAL_ERR;	// jump to entry point implementing the opcode (or break if we went into the weeds)
			
			.map 0b????????;							// opcode sink of last resort
badop:		goto INTERNAL_ERR;
	
			////////////////////////////////////////////////////////////////////////////////
			.map 0b00000???;							// SX (Stack exchange, 0x00 .. 0x07)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 15;								// trace mnemonic
			ExpStack <= startSwap;	// R <= ExpStack(0), S <= ExpStack(0 + param) 
			ExpStack <= endSwap;	// ExpStack(0) <= S, ExpStack(0 + param) <= R
			goto fetch;

			.map 0x00;									// SX 0 does nothing, so map to just skip
			traceSDepth;
			traceString 15;								// trace mnemonic
			goto fetch;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x08;									// NOP (No operation)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 12;
			goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x09;									// LB (Push literal byte onto stack)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 28;
lb_push:	traceString 3, T <= codeByte;
			ExpStack <= push_TByte;
			IL_PC <= inc, if STACK_IS_FULL then ESTACK_ERR else fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x0A;									// LN (Push literal word onto stack)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 29;
			traceString 3, T <= codeByte;
			ExpStack <= push_TByte;	
			IL_PC <= inc, if STACK_IS_FULL then ESTACK_ERR else lb_push;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x0B;									// DS (Duplicate Stack)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 38;
			if STACK_IS_EMPTY then ESTACK_ERR;
			T <= ExpStack, if STACK_IS_FULL then ESTACK_ERR;
			ExpStack <= push_TWord, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x0C;									// SP (Stack Pop)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 34;
			if STACK_IS_EMPTY then ESTACK_ERR;
			ExpStack <= pop2, goto fetch;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x10;									// SB (Save Basic Pointer)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 10;								// trace mnemonic
			if BP_IN_INPLINE then next else ptr_exc;
save_bp:	SvPt <= BP;
bp_done:	traceBP();									// trace value of Basic Pointer
			goto fetch;					

			////////////////////////////////////////////////////////////////////////////////
			.map 0x11;									// RB (Restore Basic Pointer)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 11;								// trace mnemonic
			if SVP_IN_INPLINE then save_bp;	
ptr_exc:	SvPt <= BP, BP <= SvPt, goto bp_done;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x12;									// FV (Fetch Variable)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 36;								// trace mnemonic
			if STACK_IS_EMPTY then ESTACK_ERR;
			Vars <= indexFromExpStack;
			T <= from_vars, ExpStack <= pop1;
			ExpStack <= push_TWord, goto fetch;			

			////////////////////////////////////////////////////////////////////////////////
			.map 0x13;									// SV (Store Variable)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 37;								// trace mnemonic
			if STACK_IS_EMPTY then ESTACK_ERR;
			T <= ExpStack, ExpStack <= pop2;
			if STACK_IS_EMPTY then ESTACK_ERR;
			Vars <= indexFromExpStack, ExpStack <= pop1;
			Vars <= T, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x16;									// GO (GOTO)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 55;										// Trace mnemonic
			T <= XQhere;
			IL_PC <= T, if STACK_IS_EMPTY then ESTACK_ERR;		// IL_PC <= XQhere
			alu <= R_fromStack, ExpStack <= pop2;
			traceALU();
			if R_IS_ZERO then next else go_find;
			if IS_RUNMODE then stop_run else fetch;				// entering GOTO 0 on command line does nothing
go_find:	T <= from_R;
			Lino <= T, T <= Prog_start;							// new non-zero Lino picked up from evaluation stack
go_search:	alu <= reset1, ReadCore(T);
			alu <= Rx256_plus_MDR, T <= inc;
			ReadCore(T);
			alu <= Rx256_plus_MDR, T <= inc;
			alu <= S_fromLino, if R_IS_ZERO then stop_run;		// TODO: "line xxx not found in yyy" message?
			alu <= S_minus_R;									// Lino - inspected line
			if Y_ZERO then go_found;
			findNextCR(same);
			T <= inc, goto go_search;			
go_found:	BP <= T, goto fetch;			

			////////////////////////////////////////////////////////////////////////////////
			.map 0x17;									// NE (Negate)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 25;								// Trace mnemonic
			alu <= R_fromStack, if STACK_IS_EMPTY then ESTACK_ERR;
			ExpStack <= pop2;
			alu <= neg_R, if ALU_READY then alu_done else repeat;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x18;									// AD (Add)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 22;								// Trace mnemonic
			pullRS();
			alu <= S_plus_R, if ALU_READY then next else repeat;
alu_done:	traceALU();
			T <= from_Y, if ALU_OVERFLOW then OVERFLOW_ERR;
			ExpStack <= push_TWord, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x19;									// SB (Substract)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 23;								// Trace mnemonic
			pullRS();
			alu <= S_minus_R, if ALU_READY then alu_done else repeat;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1A;									// MP (Multiply)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 24;								// Trace mnemonic
			pullRS();
			alu <= S_mul_R, if ALU_READY then alu_done else repeat;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1B;									// DV (Divide)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 35;								// Trace mnemonic
			pullRS();
			alu <= div_start, if R_IS_ZERO then DIVBY0_ERR;
div_loop:	nop;
			//trace(CRLF);
			//traceBP();
			//traceY();
			alu <= div_shift;
			if ALU_READY then div_done;
			//trace(CRLF);
			//traceBP();
			//traceY();		
			alu <= div_subset, goto div_loop; 
div_done:	alu <= div_end, goto alu_done;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1D;									// NX (Next Basic statement)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 39;								// Trace mnemonic
			if IS_RUNMODE then nx_run;
			IL_PC <= zero, goto fetch;					// command mode, restart at reading the input buffer
nx_run:		findNextCR(BP);
			T <= inc;
			BP <= T;									// BP at start of next statement, which is 2 bytes containing the line number
			readCore16(BP);
			if R_IS_ZERO then nx_err;
			BP <= T, T <= from_R;						// BP at start of statement text, load T with new line number
			Lino <= T;									// new current executing statement line number 
			T <= XQhere;
			IL_PC <= T;									// IL_PC <= XQhere
			if CHARIN_READY then next else fetch;		// nothing was pressed, continue
			gotChar = 1, directByte = CTRL_C, if CHARIN_EQU_DB then nx_err else fetch;	// break only if CTRL/C received			
nx_err:		directByte = BEEP, outChar(from_microcode);	// TODO - write some error that we ran out of code?
			goto stop_run;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1F;									// LS (List Basic program)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 41;								// Trace mnemonic
			alu <= reset1, if IS_RUNMODE then badop;	// S == from == 0, R == to == 65535
ls_parload:	T <= from_R, if STACK_IS_EMPTY then ls_parchk;
			alu <= S_fromT;
			alu <= R_fromStack, ExpStack <= pop2, goto ls_parload;
ls_parchk:  traceALU();
			alu <= ls_load;								// loads Y with S and R, also checks that R >= S and neither are 0
			if LS_PARAMS_OK then next else SYNTAX_ERR;
ls_start:	T <= Prog_start; 
			traceALU();
ls_lineloop:if CHARIN_READY then next else ls_nobreak;		// check if a character came in
			gotChar = 1, directByte = CTRL_C, if CHARIN_EQU_DB then crlf_fetch;	// bail if it was a CTRL/C (break)
			directByte = ' ', if CHARIN_EQU_DB then next else ls_nobreak;	// SPACE pauses/resumes listing
ls_pause:	if CHARIN_READY then next else repeat;							// SPACE detected, now wait for next char
			gotChar = 1, directByte = ' ', if CHARIN_EQU_DB then next else ls_pause; 
ls_nobreak:	gotChar = 1, readCore16(same);
			T <= dec, alu <= ls_check, if R_IS_ZERO then crlf_fetch;	// found 2 zero bytes, so at the end of Basic program
			traceALU();
			if LS_IN_RANGE then next else ls_skipline;		// current line >= from
			printDecR();									// output line number
			directByte = ' ', outChar(from_microcode);		// followed by a single space
ls_nextchar:T <= inc;
			ReadCore(T);									// read from Basic program text		
			outChar(from_MDR);								// output verbatim
			directByte = CR, if MDR_EQU_DB then next else ls_nextchar;  // loop until CR found, which is end of Basic line
			directByte = LF, outChar(from_microcode);		// output LF after CR
ls_nextline:T <= inc, goto ls_lineloop;						// continue with next Basic line 
ls_skipline:T <= inc;
			ReadCore(T);
			directByte = CR, if MDR_EQU_DB then ls_nextline else ls_skipline;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x20;									// PN (Print number)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 26;								// Trace mnemonic
			if STACK_IS_EMPTY then ESTACK_ERR;
			printDec();
			goto fetch;
						
			////////////////////////////////////////////////////////////////////////////////
			.map 0x21;									// PQ (Print basic string)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 18;								// Trace mnemonic
pq_loop:	BP <= inc, ReadCore(BP);
			directByte = '"', if MDR_EQU_DB then pq_done;
			outChar(from_MDR);
			traceString 3;
			directByte = CR, if MDR_EQU_DB then INTERNAL_ERR else pq_loop;	// found CR under quotes!
pq_done:	traceBP();
			goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x22;									// PT (Print TAB)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 27;								// Trace mnemonic
pt_loop:	if AT_TAB then fetch;						// bail if at positions 0, 8, 16, 24, etc.
			directByte = ' ', outChar(from_microcode);	// this should increment the tab_cnt mantained by the CPU
			goto pt_loop;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x23;									// NL (Print newline)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 6;								// Trace mnemonic
crlf_fetch:	outCRLF();
			goto fetch;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x24;									// PC (Print literal string)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 5;								// Trace mnemonic
pc_loop:	outChar(from_interpreter);
			traceString 3;								// trace value of IL(IL_PC) (which was the char to be output)
			if ILCODEBYTE_BIT7 then pc_exit;			// print until char with bit7 set
			IL_PC <= inc, goto pc_loop;
pc_exit:	IL_PC <= inc, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x27;									// GL (Get Input line)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 8;								// Trace mnemonic
gl:			InlEnd <= InLine_start;
gl_loop:	if CHARIN_READY then next else repeat;		// wait for input character
			if CHARIN_PRINTABLE then gl_print;
			directByte = CR, if CHARIN_EQU_DB then gl_cr;
			directByte = BACKSPACE, if CHARIN_EQU_DB then gl_bs;
			directByte = ESC, if CHARIN_EQU_DB then gl_esc;
			//directByte = TAB, if CHARIN_EQU_DB then gl_tab;		// TODO - implement TAB
			// fall into ignorable characters
gl_ignore:	directByte = BEEP, outChar(from_microcode); // BEEP, then get next char
			gotChar = 1, goto gl_loop;

gl_print:	if INLEND_MAX then gl_ignore;
			outChar(from_charin);						// ECHO
			WriteCore(InlEnd, CHARIN);
			InlEnd <= inc;
gl_write0:	WriteCore(InlEnd, zero);
			gotChar = 1, goto gl_loop;
					
gl_esc:		directByte = BEEP, outChar(from_microcode); // BEEP, then get next line (ignore this one)
			outCRLF();									// start fresh line
			gotChar = 1, goto gl;
			
gl_bs:		if INLEND_MIN then gl_ignore;
			directByte = BACKSPACE, outChar(from_microcode);	// ECHO
			InlEnd <= dec, goto gl_write0;
			
gl_cr:		WriteCore(InlEnd, CHARIN);
			InlEnd <= inc;
			WriteCore(InlEnd, zero);
			dump_input();
			outCRLF();
			gotChar = 1, BP <= Inline_start, goto fetch;	

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2A;									// IL (insert Basic line)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 40;								// Trace mnemonic
			T <= ExpStack;
			Lino <= T, ExpStack <= pop2, alu <= S_fromT;
			traceLino;
			alu <= S_minus_R;							// compare Lino - 0
			if Y_SIGN then SYNTAX_ERR;					// error if line number is negative
			if Y_ZERO then SYNTAX_ERR;					// error if zero line number
			skipSpaces();								// BS now points to first char of the new Basic line in input buffer
			directByte = CR, if MDR_EQU_DB then delLine;	// check for empty line, which means request to delete the "Lino" line
			
			//--- inserting a line ---
insLine:    findNextCR(BP);
			BE <= T;									// command STRING is from BS to BE inclusive (line number is in Lino)
insLine1:	findPrgEnd(Prog_start);
			findBasLine(Prog_start);
			if R_IS_ZERO then appendLine;				// new line is the highest in the program
			alu <= S_minus_R;							// Lino - foundLineNumber
			if Y_ZERO then replaceLine;
			if Y_SIGN then next else INTERNAL_ERR;		// Error if somehow Lino is higher than found line
			//--- inserting before next higher number line ---
			insLnBefore(); 
			goto fetch;
			
			// first we delete the line with Lino number, then insert from the input buffer
replaceLine:delBasLine();
			goto insLine1;								// TODO: yes, this looks like a possible dead loop :-)

appendLine:	T <= PrgEnd;
			alu <= S_fromLino, T <= dec;				// go back one to overwrite the first NULL char too
			WriteCore(T, from_SHi);						// Line number in binary, MSB first
			T <= inc;
			WriteCore(T, from_SLo);						// Line number in binary, LSB last
			T <= inc;
app_loop:	ReadCore(BP);								// copy from input buffer
			WriteCore(T, same);							// to Basic program area
			BP <= inc, T <= inc;			
			directByte = CR, if MDR_EQU_DB then next else app_loop;
			write2Nulls(same);
			goto fetch;

			//--- deleting a found line ---
delLine:	findPrgEnd(Prog_start);
			findBasLine(Prog_start);					// no need to search for BE, must be equal to BP
			if Y_ZERO then next else WarmStart;			// TODO, is this the right jump target for no operation?
			delBasLine();
			goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2B;									// MT (Mark the BASIC program space Empty)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 43;								// Trace mnemonic
			goto ColdStart;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2C;									// XQ (Start Execute)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 42;								// Trace mnemonic
			T <= IL_PC;
			XQhere <= T, readCore16(Prog_start);		// XQhere <= IL_PC, find line number of first statement
			if R_IS_ZERO then NOPROG_ERR;
			BP <= T, T <= from_R;						// BP at text of first line, T contains its statement number
			Lino <= T, goto fetch; 						// Lino is set to line number of first program statement			

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2D;									// WS (Stop Execute)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 44;								// Trace mnemonic
stop_run:	directByte = 'S', outChar(from_microcode);
			directByte = 'T', outChar(from_microcode);
			directByte = 'O', outChar(from_microcode);
			directByte = 'P', outChar(from_microcode);
			goto print_lino;
						
findPrgEnd: alu <= reset1;					// S = 0, R = -1, T = param;
fpend_loop:	ReadCore(T);
			alu <= Rx256_plus_MDR;
			if R_IS_ZERO then fpend_exit;	// 0 - two bytes in R				
			T <= inc, goto fpend_loop;
fpend_exit:	PrgEnd <= T, back;			
			
delBasLine: alu <= copy_setup;		// R = LS, S = LE + 1, Y = PrgEnd - LE
dbs_loop:	traceALU();
			T <= from_S;
			ReadCore(T);
			T <= from_R;
			WriteCore(T, same);
			alu <= copy_next;		// R++, S++, Y--
			if Y_ZERO then return else dbs_loop;

insLnBefore:goto INTERNAL_ERR;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x2F;									// RT (IL subroutine return)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 19;								// Trace mnemonic
			if STACK_IS_EMPTY then RSTACK_ERR;
			IL_PC <= RetStack, RetStack <= pop, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b00110???;							// JS (IL subroutine call, 0x3000..0x37FF)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 20;								// Trace mnemonic
			traceString 3;
			if STACK_IS_FULL then RSTACK_ERR;
			RetStack <= push_IL_PC_PLUS_1, goto jump;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b00111???;							// J (Jump, 0x3800..0x3FF)		
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 21;								// Trace mnemonic
			traceString 3;								// trace lower 8-bits of destination
jump:		IL_PC <= direct11, goto fetch;
			
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0b01??????;							// BR (relative branch, 0x40..0x7F)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 7;								// Trace mnemonic
			IL_PC <= pc_plus_off6;						// jump destination (+/- 31 locations)
br_exit:	traceGoto;									// trace target
			goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b01100000;							// BR (relative branch with 0 offset)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 7;								// Trace mnemonic
			goto badop;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b100?????; 							// BC a "xxx"   (80xxxxXx-9FxxxxXx  String Match Branch)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 17;								// Trace mnemonic
			T <= IL_PC, BP <= save, skipSpaces();
bc_loop:	traceString 3;								// trace value of IL(IL_PC) (char we try to match)
			ReadCore(BP);
			if MDR_MATCHES_ILCODEBYTE then next else bc_exit;
			if ILCODEBYTE_BIT7 then bc_match;
			BP <= inc, IL_PC <= inc, goto bc_loop;
bc_match: 	BP <= inc, IL_PC <= inc;					// leave pointers right after
			traceBP();
			goto fetch;
bc_exit:	BP <= restore, IL_PC <= T; 					// not found, restore BP and IL_PC
			traceBP();
			IL_PC <= pc_plus_off5, goto br_exit;
					
			////////////////////////////////////////////////////////////////////////////////
			.map 0b101?????;							// BV (Branch if not variable, 0xA0..0xBF)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 16;								// Trace mnemonic
			skipSpaces();
			MDR <= ToUpper, if MDR_IS_ALPHA then bv_exec;	// test covers lowercase too, so can execute conversion and check in parallel	
			IL_PC <= pc_plus_off5, if OFF_IS_ZERO then badop else br_exit;		// jump destination (+ 31 locations)
bv_exec:	T <= MDRx2, if STACK_IS_FULL then ESTACK_ERR;
			ExpStack <= push_TByte, BP <= inc, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b110?????;							// BN (Branch if not a number, 0xC0..0xDF)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 14;								// Trace mnemonic
			skipSpaces();
			alu <= reset0, if MDR_IS_NUM then bn_loop;			// MDR was already loaded by skipSpaces()
			IL_PC <= pc_plus_off5, if OFF_IS_ZERO then badop;	// jump destination (+ 31 locations)
bn_exit:	traceY();												// trace integer parse result
			traceGoto;											// trace target
			goto fetch;
bn_loop:	alu <= Yx10_plus_MDR, BP <= inc;
			if ALU_OVERFLOW then OVERFLOW_ERR;
			ReadCore(BP);
			if MDR_IS_NUM then bn_loop;
			T <= from_Y, if STACK_IS_FULL then ESTACK_ERR;
			ExpStack <= push_TWord, goto bn_exit;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b111?????;							// BE (Branch if not endline, 0xE0..0xFF)
			////////////////////////////////////////////////////////////////////////////////
			traceSDepth;
			traceString 13;								// Trace mnemonic
			skipSpaces();
			directByte = CR, if MDR_EQU_DB then fetch;	// found a CR, continue with next IL instruction
			IL_PC <= pc_plus_off5, goto br_exit;		// jump destination (+ 31 locations)
//			IL_PC <= pc_plus_off5, if OFF_IS_ZERO then next else br_exit;		// jump destination (+ 31 locations)
//			directByte = CR, if MDR_EQU_DB then fetch else badop;
			
NOPROG_ERR:		traceString 50;
				goto traceError;
DIVBY0_ERR:		traceString 57;
				goto traceError;
OVERFLOW_ERR: 	traceString 58;
				goto traceError;
SYNTAX_ERR:		traceString 61; 
				goto traceError;
INTERNAL_ERR: 	traceString 62; 
				goto traceError;
ESTACK_ERR:		traceString 60; 
				goto traceError;
RSTACK_ERR:		traceString 59;
traceError:		outCRLF();
				trace(crlf);
				directByte = BEEP, outChar(from_microcode);
				directByte = 'E', outChar(from_microcode);
				directByte = 'R', outChar(from_microcode);
				directByte = 'R', outChar(from_microcode);
				directByte = ' ', outChar(from_microcode);
				directByte = '#', outChar(from_microcode), T <= IL_PC;
				T <= dec;				// IL_PC is already on next instruction, so go back one for correctness
				alu <= R_fromT, printDecR();
				if IS_RUNMODE then next else err_done;
print_lino:		directByte = ' ', outChar(from_microcode);
				directByte = 'A', outChar(from_microcode);
				directByte = 'T', outChar(from_microcode);
				directByte = ' ', outChar(from_microcode), alu <= S_fromLino;
				T <= from_S;
				alu <= R_fromT, printDecR();
err_done:		outCRLF();
				trace(crlf);
				goto WarmStart;

findNextCR: ReadCore(T);
			directByte = CR, if MDR_EQU_DB then return;			// return with T pointing to CR
			directByte = NULL, if MDR_EQU_DB then INTERNAL_ERR;	// finding NULL before CR is unexpected, TODO "code corruption error"?
			T <= inc, goto findNextCR;		

readCore16:	ReadCore(T);
			alu <= Rx256_plus_MDR, T <= inc;
			ReadCore(T);
			alu <= Rx256_plus_MDR, T <= inc, back;				// return with T pointing to first char after the 16-bit word

// Search the Basic text for line with number in Lino, starting with param passed into T
// Exit on found: R is found line (same of first higher than Lino), LS at begin of line number, ES at CR
// Exit on not found: R is 0, LS and LE same as input param (usually Prog_start)
// Error: found line start, but not the end, bail to error handling			
findBasLine:alu <= reset1; 
			alu <= S_fromLino, LS <= T;			// S = Lino, R = -1, T = param;
			readCore16(same);
			if R_IS_ZERO then return;			// found 2 zero bytes, so at the end of Basic program
			alu <= S_minus_R;					// compare Lino with word from memory
			if Y_ZERO then fbs_found;			// found it exact line 
			if Y_SIGN then fbs_found; 			// found next higher line
			findNextCR(same);					// not found, look for CR which marks end of Basic statement
			T <= inc, goto findBasLine;			// T is at LE of this line
fbs_found:	findNextCR(same);
			LE <= T, back;

write2Nulls:WriteCore(T, zero), T <= inc;
			WriteCore(T, zero);									// return with T pointing to last NULL! 
			back;			

			// get 2 parameters from top of evaluation stack into ALU input registers R and S
pullRS:		alu <= R_fromStack;
			ExpStack <= pop2, if STACK_IS_EMPTY then ESTACK_ERR;
			alu <= S_fromStack;
			ExpStack <= pop2, if STACK_IS_EMPTY then ESTACK_ERR else return;
			
			// print signed 16-bit number on top of evaluation stack
printDec:	alu <= R_fromStack, ExpStack <= pop2;
printDecR:	alu <= bcd_start; 
			alu <= bcd_next, if ALU_READY then next else repeat;	// repeat 16 times for each bit in R 
			//traceY();
			if ALU_SIGN then next else pn_5;
			directByte = '-', outChar(from_microcode); 				// print minus sign
pn_5:		if LEADING_ZERO then pn_4; 
			outChar(from_YtoAlpha);
pn_4:		alu <= Yx16;
			if LEADING_ZERO then pn_3;
			outChar(from_YtoAlpha);
pn_3:		alu <= Yx16;
			if LEADING_ZERO then pn_2;
			outChar(from_YtoAlpha);
pn_2:		alu <= Yx16;
			if LEADING_ZERO then pn_1;
			outChar(from_YtoAlpha);
pn_1:		alu <= Yx16;
			if LEADING_ZERO then pn_0;
			outChar(from_YtoAlpha);
pn_0:		alu <= Yx16;
			CHAROUT <= from_YtoAlpha, goto outChar;			// saving 1 microinstruction here...
				
skipSpaces: ReadCore(BP);
			directByte = ' ', if MDR_EQU_DB then skipSp;
			directByte = TAB, if MDR_EQU_DB then skipSp else return;		
skipSp:		BP <= inc, goto  skipSpaces;			
			
outCRLF:	directByte = CR, outChar(from_microcode);		
			directByte = LF, CHAROUT <= from_microcode;		// use the old fall-through trick to save time and space
outChar:	if CHAROUT_READY then next else repeat;			// sync with baudrate clock
			if CHAROUT_READY then next else repeat;
			back;										
			
WriteCore:	nBUSREQ = 0, if nBUSACK then repeat else next;
			nBUSREQ = 0, nWR = 0, back;

ReadCore:	nBUSREQ = 0, if nBUSACK then repeat else next;
			nBUSREQ = 0, nRD = 0, MDR <= from_Bus, back;
			
// 	Debug related subroutines
//	---------------------------------------------------------------------------		
dump_input: InlEnd <= InLine_start, trace(crlf);
dump_inlp:	ReadCore(InlEnd);
			directByte = 9, trace(from_microcode);		// display memory byte as Hex
			directByte = NULL, if MDR_EQU_DB then dump_inex;
			InlEnd <= inc, goto dump_inlp; 
dump_inex:	trace(crlf);
			back;			
			
traceBP:	ExpStack <= push_TWord, T <= BP;
			traceString 33;
			T <= ExpStack, ExpStack <= pop2, back;

traceY:		ExpStack <= push_TWord, T <= from_Y;
			traceString 32;
			T <= ExpStack, ExpStack <= pop2, back;
			
traceALU:	trace(crlf);
		    ExpStack <= push_TWord, traceT;
			T <= from_S, traceString 54;
			T <= from_R, traceString 55;
			T <= from_Y, traceString 32;
			T <= ExpStack, ExpStack <= pop2, DBGINDEX <= crlf;		
trace:		if DBG_READY then next else repeat;	// sync with baudrate clock that drives UART
			if DBG_READY then next else repeat;
			if DBG_READY then next else repeat;
			DBGINDEX <= zero, back;				// clear the serial debug output register and return
					
//dump_il:	directByte = 1, trace(from_microcode);		// display current IL and header to ROM
//			trace(crlf);
//			T <= IL_PC, IL_PC <= zero; 	// save IL and set to 0 to cover the ROM
//dump_il_lp:	if IL_A_VALID then next else dump_il_ex;
//			directByte = 2, trace(from_microcode);
//			directByte = 3, trace(from_microcode);
//			trace(crlf);
//			IL_PC <= inc, goto dump_il_lp; 
//dump_il_ex:	IL_PC <= T, back;	// restore IL and return
