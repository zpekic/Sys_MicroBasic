//----------------------------------------------------------
//	MicroBasic Microcode (c) 2025-... zpekic@hotmail.com
//  Compile with https://github.com/zpekic/MicroCodeCompiler
//----------------------------------------------------------
			.code 9, 80, mb:microBasic_code.vhd, 10;
			.mapper 8, 16, mb:microBasic_map.vhd, 2;
			.controller microBasic_control_unit.vhd, 4;
			.symbol 9, 128, mb:microBasic_sym.vhd, 16;

// System interface signals
nWR				.valfield 1 values 0, 1 default 1;
nRD				.valfield 1 values 0, 1 default 1;
// nBUSACK		consumed as condition
// A(15..0)		
// D(7..0)

seq_cond:		.if 5 values 
				true, 					// hard-code to 1
				ILCODEBYTE_BIT7,	 
				CHAROUT_READY,	
				IS_CPU32,				// 1 if Tiny Basic CPU uses 32-bit data
				DBG_READY | KBD_BREAK,	// high if tracer has processed the trace character, or presence of CTRL/C in charin if not tracing
				MDR_MATCHES_DB,		
				nBUSACK,				   // low if memory is ready for read/write		
				INLEND_MAX	| BASLINE_FOUND,		
				INLEND_MIN	| IMPLINE_EMPTY,		
				CHARIN_PRINTABLE,		// ASCII code in range 0x20 .. 0x7E		
				CHARIN_EQU_DB,		
				CHARIN_READY,		
				BP_IN_INPLINE,		
				SVP_IN_INPLINE,		
				MDR_IS_NUM,				// MDR contains ASCII 0..9
				MDR_IS_ALPHA,
				STACK_IS_FULL,			// condition is multiplexed from BStack, EStack, or RStack state based on IL_OP value
				STACK_IS_EMPTY,			// condition is multiplexed from BStack, EStack, or RStack state based on IL_OP value
				MDR_MATCHES_ILCODEBYTE | MDR_MATCHES_VARNAME,
				R_IS_ZERO,
				Y_ZERO			| CP_SKIP,
				Y_SIGN,
				ALU_READY		| LS_PARAMS_OK,
				ALU_OVERFLOW 	| LS_PASSED_END,
				ALU_SIGN		| LS_IN_RANGE,
				AT_TAB,
				OFF_IS_ZERO,
				IS_RUNMODE,
				S_EQU_DB_MOD32,	
				CACHE_VALID		| FOR_SET,		
				CACHE_HIT		| NEXT_SET,		
				false					// hard-code to 0
				default true;
seq_then:	.then 9 values next | continue, repeat, return, fork, @ default next;						// any label
seq_else:	.else 9 values next | continue, repeat, return, fork, 0b000000..0b111111, @ default next;	// any value as it can be a trace char

// Direct byte, usually ASCII code
directByte	.valfield 7 values 0x00..0x7F default 0x7F;

// 16 bit temporary register
T			.regfield 5 values
				same,
				IL_PC,
				XQhere,
				from_vars,
				ExpStack,
				from_YLo,
				from_YHi,
				zero,
				codeByte,
				MDR,
				MDRx2,
				inc,
				dec,
				BP,
				Prog_start,
				PrgEnd,
				from_S,
				from_R,
				save,
				recall,
				BasStack_Hi,
				BasStack_Lo,
				Cache_Data,		// bits 31..16 contain the BP (Lino is at (15..0), handled in hardware) 
				LS,
				binop,			// operation is defined by bits 2,1,0 of S register
				fromTicks,		// 2 counters running while Basic code is executing
				from_var_For,
				from_var_Next,
				index2address,
				fromSize,		// free RAM size calculation result
				from_microcode,
				-				
				default same;
				
// contains ASCII char for DEBUG UART transmit
DBGINDEX		.regfield 2 values 
				same,
				from_microcode,
				zero,
				crlf // shortcut to index 63 which should contain CR, LF, NULL sequence
				default same;		

// 11-bit IL program counter
IL_PC:			.regfield 3 values
				same,
				XQhere,
				inc,
				T,
				pc_plus_off6,
				pc_plus_off5,
				direct11,
				RetStack
				default same;

// 11-bit saved IL_PC (pointing to start of XQ/execute routine in IL program)
XQhere			.regfield 1 values
				same,
				T
				default same;
				
// 8-bit IL opcode (CPU "instruction register")
IL_OP:			.regfield 1 values
				same,
				from_interpreter
				default same;

// For IL call / return
RetStack		.regfield 2 values
				same,
				clear,
				pop,
				push_IL_PC_PLUS_1
				default same;

// For Basic GOSUB / RETURN
BasStack		.regfield 2 values
				same,
				clear,
				pop,
				push_Lino_and_BP
				default same;

// For expression evaluation
ExpStack		.regfield 3 values
				same,
				clear,
				startSwap,
				endSwap,
				push_TWord,
				push_TByte,
				pop2,
				pop1
				default same;

// 8-bit char to be output
CHAROUT:		.regfield 3 values
				same,
				from_interpreter, 
				from_microcode,
				from_charin,
				from_MDR,
				from_YtoAlpha,	// load ASCII code based on BCD character in Y top nibble	
				from_YtoAlphaZ, // same, but with leading zero supression
				-
				default same;

// 16-bit Memory Address Register
MAR:			.regfield 2 values
				same, 
				InlEnd,
				BP,
				T
				default same;
				
// 8-bit Memory Data Register
MDR:			.regfield 3 values
				same, 
				from_Bus,		// Only way to read byte from Basic program or Input line ("core memory")
				zero,
				CHARIN,
				ToUpper,
				from_SHi,
				from_SLo,
				from_microcode
				default same;

// 16-bit pointer to input buffer
InlEnd			.regfield 2 values
				same,
				InLine_start,
				inc,
				dec
				default same;

// 16-bit Basic pointer
BP				.regfield 3 values
				same,
				InLine_start,
				SvPt,
				inc,
				save,
				recall,
				T,
				LS
				default same;

// 16-bit saved basic pointer
SvPt			.regfield 2 values
				same,
				InLine_start,
				BP,
				-
				default same;
								
// flag to reset input character ready flag
gotChar			.valfield 1 values 
				0,
				1
				default 0;				

Vars			.regfield 3 values
				same,
				indexFromExpStack,
				T,
				-,
				for_fromLino,
				next_fromBP,
				for_clear,
				next_clear
				default same;				
								
// 16-bit ALU, with input regs R and S and output Y
alu				.regfield 5 values
				nop, 
				reset0,
				reset1,
				R_fromStack,
				S_fromStack,
				S_plus_R,
				S_minus_R,
				neg_R,
				S_mul_R,
				Yx16,
				bcd_start,
				bcd_next,
				div_start,
				div_shift,
				div_subset,
				div_end,
				Yx10_plus_MDR,
				Rx256_plus_MDR,
				S_fromT,
				R_fromT,
				S_fromLino,
				copy_init_del,
				copy_next,
				copy_init_ins,
				ls_load,
				ls_check,
				Y_save,
				Y_recall,
				cache_store,	// GOTO cache hooked up behind ALU to save microcode width bits
				for_step,
				for_check,
				S_swap32	// uniquely, this is a NOP in 16-bit CPU
				default nop;

// 16-bit Basic line number
Lino			.regfield 1 values
				same,
				T
				default same;

// 16-bit pointer to end of command / statement in input line (points to CR, BP is the start)
BE				.regfield 1 values
				same,
				T
				default same;

// 16-bit pointer to start of Basic statement (points to first byte of line number)
LS				.regfield 1 values
				same,
				T
				default same;
				
// 16-bit pointer to end of Basic statement (points to CR, LS is the start)
LE				.regfield 1 values
				same,
				T
				default same;
				
// 16-bit pointer to end of Basic program (points to last of two consecutive NULL chars)
PrgEnd			.regfield 1 values
				same,
				T
				default same;
				
// placeholder
//dummy:			.valfield 1 values * default 0;
						
//	useful aliases, these are evaluated as simple text replacement of label with everything between .alias and ; 
NULL: 		.alias 0x00;
//STX:		.alias 0x03;	// CTRL/C
ESC:		.alias 0x1b;
BEEP:		.alias 0x07;
BACKSPACE:	.alias 0x08;
TAB:		.alias 0x09;
LF:		.alias 0x0A;
CR:		.alias 0x0D;
//SPACE:	.alias 0x20;
//DQUOTE:	.alias 0x22;
clear:		.alias DBGINDEX <= zero, ExpStack <= clear, RetStack <= clear, BasStack <= clear, T <= zero, alu <= reset0;
nop:		.alias if true then continue else repeat;
goto:		.alias if false then continue else;
back:	    .alias if true then return else continue;
traceString .alias trace(from_microcode), directByte =;
traceGoto	.alias trace(from_microcode), directByte = 30;
traceCall	.alias trace(from_microcode), directByte = 31;
//traceLino	.alias trace(from_microcode), directByte = 51;
traceT		.alias trace(from_microcode), directByte = 52;
traceSDepth:.alias trace(from_microcode), directByte = 56;	// trace stack depth by indenting 0 to 8 spaces
//waitForExt:	.alias if EXTERNAL then next else repeat;		// loop until external signal is high (e.g. button is pressed)

// gosub definitions - this works because "jump" pushes return address to stack if both then/else are same
//dump_il:	.sub;
//dump_input:	.sub;
div_mod:	.sub;
trace:		.sub DBGINDEX;
outCRLF:	.sub;
outChar:	.sub CHAROUT;
outNZChar:	.sub CHAROUT;
writeCore:	.sub MAR, MDR;
readCore:	.sub MAR;
skipSpaces:	.sub;
pullRS:		.sub;
printDec:	.sub;
printDecR:	.sub alu;
copyCore:	.sub alu;
scanProgram:	.sub;
findNextCR:	.sub T;
write2Nulls:	.sub T;
readCore16:	.sub alu, T;
traceALU:	.sub;
traceY:		.sub;
traceBP:	.sub;
outBeep:	.sub;
findLino:	.sub T;
findNx:		.sub;
copyLine:	.sub T;
findPrgEnd:	.sub;
prepWrite:	.sub;
writeS16:	.sub;

			.org 0;
//	First 4 microcode locations can't be used branch destinations
//	---------------------------------------------------------------------------
_reset:		nop;			// TODO: use these 4 microcycles for cold start intialization  

_reset1:	T <= zero;

_reset2:	XQhere <= T;

_reset3:	nop;

//	indicate availability and wait for start signal
//	---------------------------------------------------------------------------
ColdStart:	write2Nulls(Prog_start);														// kills program area
WarmStart:	clear, findPrgEnd();															// correct PrgEnd is needed for @(..) array and SIZE()
WarmStart2:	BP <= InLine_start, SvPt <= InLine_start, InlEnd <= InLine_start, T <= zero; 
			Lino <= T, IL_PC <= T, write2Nulls(BP);											// kills input line
			
fetch:		traceString 51;											// CR, LF, then trace Basic line number (in hex, for speed)
fetch1:		traceString 2; 											// trace IL_PC and future opcode
			IL_OP <= from_interpreter, IL_PC <= inc, traceSDepth;	// load opcode, advance IL_PC, indent by stack depth IL code if tracing is on
			T <= zero, alu <= reset0, if true then fork else INTERNAL_ERR;	// jump to entry point implementing the opcode
			
			.map 0b????????;							// opcode sink of last resort
badop:		goto INTERNAL_ERR;
	
			////////////////////////////////////////////////////////////////////////////////
			.map 0b00000???;							// SX (Stack exchange, 0x00 .. 0x07)
			////////////////////////////////////////////////////////////////////////////////
			traceString 15;								// trace mnemonic
			ExpStack <= startSwap, traceString 51;		// R <= ExpStack(0), S <= ExpStack(0 + param) 
			ExpStack <= endSwap, goto fetch1;			// ExpStack(0) <= S, ExpStack(0 + param) <= R

			.map 0x00;									// SX 0 does nothing, so map to just skip
			traceString 15;								// trace mnemonic
			goto fetch;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x08;									// NOP (No operation)
			////////////////////////////////////////////////////////////////////////////////
			traceString 12;
			goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x09;									// LB (Push literal byte onto stack)
			////////////////////////////////////////////////////////////////////////////////
			traceString 28;
lb_push:	traceString 3, T <= codeByte;
			ExpStack <= push_TByte;
			IL_PC <= inc, if STACK_IS_FULL then ESTACK_ERR else fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x0A;									// LN (Push literal word onto stack)
			////////////////////////////////////////////////////////////////////////////////
			traceString 29;
			traceString 3, T <= codeByte;
			ExpStack <= push_TByte;	
			IL_PC <= inc, if STACK_IS_FULL then ESTACK_ERR else lb_push;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x0B;									// DS (Duplicate Stack)
			////////////////////////////////////////////////////////////////////////////////
			traceString 38;
			if STACK_IS_EMPTY then ESTACK_ERR;
			T <= ExpStack, if STACK_IS_FULL then ESTACK_ERR;
			ExpStack <= push_TWord, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x0C;									// SP (Stack Pop)
			////////////////////////////////////////////////////////////////////////////////
			traceString 34;
			ExpStack <= pop2, if STACK_IS_EMPTY then ESTACK_ERR else fetch;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x10;									// SB (Save Basic Pointer)
			////////////////////////////////////////////////////////////////////////////////
			traceString 10;								// trace mnemonic
			if BP_IN_INPLINE then next else ptr_exc;
save_bp:	SvPt <= BP;
bp_done:	traceBP();									// trace value of Basic Pointer
			goto fetch;					

			////////////////////////////////////////////////////////////////////////////////
			.map 0x11;									// RB (Restore Basic Pointer)
			////////////////////////////////////////////////////////////////////////////////
			traceString 11;								// trace mnemonic
			if SVP_IN_INPLINE then save_bp;	
ptr_exc:	SvPt <= BP, BP <= SvPt, goto bp_done;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x12;									// FV (Fetch Variable)
			////////////////////////////////////////////////////////////////////////////////
			traceString 36;								// trace mnemonic
			Vars <= indexFromExpStack, if STACK_IS_EMPTY then ESTACK_ERR; 	// get index (variable name A-Z)
			T <= from_vars, ExpStack <= pop1, traceString 51;				// T <= Vars(index)
			ExpStack <= push_TWord, goto fetch1;							// push onto stack, go to 2rd fetch entry point as we overlapped 1 cycle

			////////////////////////////////////////////////////////////////////////////////
			.map 0x13;									// SV (Store Variable)
			////////////////////////////////////////////////////////////////////////////////
			traceString 37;								// trace mnemonic
			if STACK_IS_EMPTY then ESTACK_ERR;
			T <= ExpStack, ExpStack <= pop2;			// pop T from stack
			Vars <= indexFromExpStack, if STACK_IS_EMPTY then ESTACK_ERR;
			ExpStack <= pop1, Vars <= T, goto fetch;	// Vars(index) <= T and remove used stack entry

			////////////////////////////////////////////////////////////////////////////////
			.map 0x14;									// GS (GoSub - save Basic line for RETURN later)
			////////////////////////////////////////////////////////////////////////////////
			traceString 47;								// Trace mnemonic
			if IS_RUNMODE then next else INTERNAL_ERR;
			if STACK_IS_FULL then BSTACK_ERR;
			BasStack <= push_Lino_and_BP, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x15;									// RS (ReStore saved line - Basic RETURN)
			////////////////////////////////////////////////////////////////////////////////
			traceString 48;								// Trace mnemonic
			if IS_RUNMODE then next else INTERNAL_ERR;
			T <= BasStack_Hi,if STACK_IS_EMPTY then BSTACK_ERR;
			Lino <= T, T <= BasStack_Lo, traceString 51;
			BP <= T, BasStack <= pop, goto fetch1;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x16;									// GO (GOTO)
			////////////////////////////////////////////////////////////////////////////////
			traceString 45;								// Trace mnemonic
			IL_PC <= XQhere, if STACK_IS_EMPTY then ESTACK_ERR;	// IL_PC <= XQhere, check stack
			alu <= R_fromStack, ExpStack <= pop2;
			T <= from_R;
			Lino <= T, if R_IS_ZERO then NOPROG_ERR;			// once Lino is set, CACHE_HIT and CACHE_VALID are meaningful
			// traceLino;
			T <= Cache_Data, if CACHE_VALID then go_cvalid;		// load T with assumed "good" cached data
			// INVALID: the cache entry is free, find target and store in cache (and stay there until end of run)
			findLino(Prog_start);
			alu <= cache_store, goto fetch;	// cache[Lino(4:0)] <= Lino & BP, cache_valid[Lino(4:0)] <= 1 
			
go_cvalid:	BP <= T, if CACHE_HIT then fetch else go_cmiss;
			// VALID HIT: pick it up and use it
			//BP <= T, goto fetch;

			// VALID MISS: other GOTO already used the entry, no attempt to kick it out, take the perf penalty
go_cmiss:	findLino(Prog_start);			
			goto fetch;
			
findLino:	alu <= reset1, readCore(T);
			alu <= Rx256_plus_MDR, T <= inc;
			alu <= S_fromLino, readCore(T);
			alu <= Rx256_plus_MDR, T <= inc;
			alu <= S_minus_R, if R_IS_ZERO then stop_run;	// TODO: "line xxx not found in yyy" message? (reached end of code without finding the target)
			//traceALU();
			BP <= T, if Y_ZERO then return;					// target line number (S) is same as line number of inspected line (R), so bail (success)
			findNextCR(same);
			T <= inc, goto findLino;						
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x17;									// NE (Negate)
			////////////////////////////////////////////////////////////////////////////////
			traceString 25;								// Trace mnemonic
			alu <= R_fromStack, if STACK_IS_EMPTY then ESTACK_ERR;
			ExpStack <= pop2, alu <= neg_R, goto alu_done;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x18;									// AD (Add)
			////////////////////////////////////////////////////////////////////////////////
			traceString 22;								// Trace mnemonic
			pullRS();
			alu <= S_plus_R, if ALU_READY then next else repeat;
alu_done:	traceALU();
			T <= from_YLo, if ALU_OVERFLOW then OVERFLOW_ERR;
u_done:		ExpStack <= push_TWord, goto fetch;		

			////////////////////////////////////////////////////////////////////////////////
			.map 0x19;									// SB (Substract)
			////////////////////////////////////////////////////////////////////////////////
			traceString 23;								// Trace mnemonic
			pullRS();
			alu <= S_minus_R, if ALU_READY then alu_done else repeat;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1A;									// MP (Multiply)
			////////////////////////////////////////////////////////////////////////////////
			traceString 24;								// Trace mnemonic
			pullRS();
			alu <= S_mul_R, if ALU_READY then alu_done else repeat;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1B;									// DV (Divide)
			////////////////////////////////////////////////////////////////////////////////
			traceString 35;								// Trace mnemonic
			pullRS();
			div_mod();
			goto alu_done;
			
div_mod:	alu <= div_start, if R_IS_ZERO then DIVBY0_ERR;
div_loop:	alu <= div_shift;
			if ALU_READY then div_done;
			alu <= div_subset, goto div_loop; 
div_done:	alu <= div_end, back;						// quotient is in YLo, remainder in YHi

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1C;									// CP (Compare)
			////////////////////////////////////////////////////////////////////////////////
			traceString 46;								// Trace mnemonic
			alu <= R_fromStack, ExpStack <= pop2;
			ExpStack <= push_TByte;						// push dummy byte to make it even
			T <= ExpStack, ExpStack <= pop2;			// load condition mask into T (16 bit)
			alu <= S_fromStack, ExpStack <= pop2, traceString 51;
			if CP_SKIP then next else fetch1;
			IL_PC <= inc, goto fetch1;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1D;									// NX (Next Basic statement)
			////////////////////////////////////////////////////////////////////////////////
			traceString 39;									// Trace mnemonic
			IL_PC <= T, if IS_RUNMODE then next else fetch; // if in command mode, restart at reading the input buffer (T is zero at start of every instruction)		
			findNx();
			Lino <= T, IL_PC <= XQhere;						// new current executing statement line number, and IL_PC at :XEC +2 
			//traceLino;
			traceBP();
			if KBD_BREAK then BREAK else fetch;

findNx:		findNextCR(BP);
			T <= inc;
			BP <= T;										// BP at start of next statement, which is 2 bytes containing the line number
			readCore16(reset1, BP);
			BP <= T, T <= from_R, if R_IS_ZERO then next else return; // BP at start of statement text, load T with new line number, check if at the end of program			 
nx_err:		directByte = BEEP, outChar(from_microcode);		// TODO - write some error that we ran out of code?
			goto stop_run;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x1F;									// LS (List Basic program)
			////////////////////////////////////////////////////////////////////////////////
			traceString 41;								// Trace mnemonic
			alu <= reset1, if IS_RUNMODE then badop;	// S == from == 0, R == to == 65535			
ls_parload:	T <= from_R, if STACK_IS_EMPTY then ls_parchk;
			alu <= S_fromT;
			alu <= R_fromStack, ExpStack <= pop2, goto ls_parload;
ls_parchk:  alu <= ls_load;								// loads Y with S and R, also checks that R >= S and neither are 0
			if LS_PARAMS_OK then next else SYNTAX_ERR;
			//traceALU();
ls_start:	T <= Prog_start;
ls_lineloop:if CHARIN_READY then next else ls_continue;	// check if a character came in
			if KBD_BREAK then BREAK;
			gotChar = 1, directByte = ' ', if CHARIN_EQU_DB then next else ls_continue;	// SPACE pauses/resumes listing
ls_pause:	if CHARIN_READY then next else repeat;			// SPACE detected, now wait for next char
			gotChar = 1, directByte = ' ', if CHARIN_EQU_DB then next else ls_pause; 
ls_continue:gotChar = 1, readCore16(reset1, same); 			// read line number into R
			alu <= ls_check, if R_IS_ZERO then fetch;		// end of program, bail
			if LS_PASSED_END then fetch;					// passed the end, bail
			if LS_IN_RANGE then next else ls_nextLine;
			//traceALU();
			T <= save, printDecR(Y_save);					// output line number (in decimal!) - this trashes T, Y so we need to restore them after
			T <= recall, alu <= Y_recall, directByte = ' ', outChar(from_microcode);	// followed by a single space
ls_charloop:readCore(T);
			outChar(from_MDR);
ls_nextchar:directByte = CR, if MDR_MATCHES_DB then next else ls_next;  	// loop until CR found, which is end of Basic line
			directByte = LF, outChar(from_microcode);			// CR was already printed, so just LF
			T <= inc, goto ls_lineloop;
ls_next:	T <= inc, goto ls_charloop;
ls_nextLine:findNextCR(same);
			T <= inc, goto ls_lineloop;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x20;									// PN (Print number)
			////////////////////////////////////////////////////////////////////////////////
			traceString 26;								// Trace mnemonic
			if STACK_IS_EMPTY then ESTACK_ERR;
			printDec();
			goto fetch;
						
			////////////////////////////////////////////////////////////////////////////////
			.map 0x21;									// PQ (Print basic string)
			////////////////////////////////////////////////////////////////////////////////
			traceString 18;								// Trace mnemonic
pq_loop:	BP <= inc, readCore(BP);
			directByte = '"', if MDR_MATCHES_DB then pq_done;
			outChar(from_MDR);
			//traceString 3;
			directByte = CR, if MDR_MATCHES_DB then INTERNAL_ERR else pq_loop;	// found CR under quotes!
pq_done:	traceBP();
			goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x22;									// PT (Print TAB)
			////////////////////////////////////////////////////////////////////////////////
			traceString 27;								// Trace mnemonic
pt_loop:	if AT_TAB then fetch;						// bail if at positions 0, 8, 16, 24, etc.
			directByte = ' ', outChar(from_microcode);	// this should increment the tab_cnt mantained by the CPU
			goto pt_loop;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x23;									// NL (Print newline)
			////////////////////////////////////////////////////////////////////////////////
			traceString 6;								// Trace mnemonic
crlf_fetch:	outCRLF();
			goto fetch;
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x24;									// PC (Print literal string)
			////////////////////////////////////////////////////////////////////////////////
			traceString 5;								// Trace mnemonic
pc_loop:	outChar(from_interpreter);
			traceString 3;												// trace value of IL(IL_PC) (which was the char to be output)
			IL_PC <= inc, if ILCODEBYTE_BIT7 then fetch else pc_loop;	// print until char with bit7 set

			////////////////////////////////////////////////////////////////////////////////
			.map 0x25;									// FS (For loop Start)
			////////////////////////////////////////////////////////////////////////////////
			traceString 4;								// Trace mnemonic - TODO
			pullRS();									// R = step, S = to
			T <= ExpStack, ExpStack <= pop2;			// T = from
			Vars <= indexFromExpStack, if STACK_IS_EMPTY then ESTACK_ERR;
			//traceALU();
			ExpStack <= pop1, if NEXT_SET then next else for_first;

			// we came from NEXT, 2nd to nth iteration
			Vars <= for_fromLino, T <= from_vars, if FOR_SET then next else SYNTAX_ERR;
			alu <= for_step;							// Y <= T + R (step)
			T <= from_YLo, goto for_check;
			
			// first time entering FOR, 1st iteration
for_first:	Vars <= for_fromLino;								
for_check:	alu <= for_check;									// see if looping is possible
			Vars <= T, if ALU_READY then for_done;				// assign "from" value to variable, ALU_READY means loop should be executed
			
			// loop conditions not satisfied, bail. This is easy if corresponding NEXT has already been executed
			T <= from_var_Next, if NEXT_SET then next else find_next;
			Vars <= for_clear, BP <= T, goto for_done;			// must exit with both fields cleared
			
			// now painfully search for NEXT <var> statement from this point to end of code
find_next:	Vars <= for_clear, findNx();
			skipSpaces();
			readCore(BP), BP <= inc;
			directByte = 'N', if MDR_MATCHES_DB then next else find_cont;	// Uppercase comparison with word NEXT
			readCore(BP), BP <= inc;
			directByte = 'E', if MDR_MATCHES_DB then next else find_cont;
			readCore(BP), BP <= inc;
			directByte = 'X', if MDR_MATCHES_DB then next else find_cont;
			readCore(BP), BP <= inc;
			directByte = 'T', if MDR_MATCHES_DB then next else find_cont;
			skipSpaces();
			readCore(BP);
			if MDR_MATCHES_VARNAME then for_done;						// Check if right loop variable name
find_cont:	findNextCR(BP);
			goto find_next; 
			// now get the Lino of first statement after NEXT <var>, or first statement after FOR <var> = ...
for_done:	Vars <= next_clear, findNx();					
			traceT;
			ExpStack <=  push_TWord, goto fetch;				// push line number of next statement to be executed on expression stack				

			////////////////////////////////////////////////////////////////////////////////
			.map 0x26;									// FE (For loop nExt)
			////////////////////////////////////////////////////////////////////////////////
			traceString 4;								// Trace mnemonic - TODO
			Vars <= indexFromExpStack, if STACK_IS_EMPTY then ESTACK_ERR;
			ExpStack <= pop1, T <= from_var_For, if FOR_SET then next else INTERNAL_ERR;	// FOR field was never set, can't loop back to FOR
			Vars <= next_fromBP, ExpStack <= push_TWord, goto fetch;					// push to stack the Line Number of corresponding FOR

			////////////////////////////////////////////////////////////////////////////////
			.map 0x27;									// GL (Get Input line)
			////////////////////////////////////////////////////////////////////////////////
			traceString 8;								// Trace mnemonic
gl:			InlEnd <= InLine_start;
gl_loop:	if CHARIN_READY then next else repeat;		// wait for input character
			if KBD_BREAK then next else gl_char;
			gotChar = 1, if IS_RUNMODE then stop_run else gl_esc;
gl_char:	if CHARIN_PRINTABLE then gl_print;
			directByte = CR, if CHARIN_EQU_DB then gl_cr;
			directByte = BACKSPACE, if CHARIN_EQU_DB then gl_bs;
			directByte = ESC, if CHARIN_EQU_DB then gl_esc;
			directByte = TAB, if CHARIN_EQU_DB then gl_tab;	// TODO - implement TAB (for now just replace with space)
			// fall into ignorable characters
gl_ignore:	directByte = BEEP, outChar(from_microcode); // BEEP, then get next char
			gotChar = 1, goto gl_loop;

gl_print:	if INLEND_MAX then gl_ignore;
			outChar(from_charin);						// ECHO
			writeCore(InlEnd, CHARIN), InlEnd <= inc;
gl_write0:	writeCore(InlEnd, zero);
			gotChar = 1, goto gl_loop;
					
gl_esc:		directByte = BEEP, outChar(from_microcode); // BEEP, then get next line (ignore this one)
			outCRLF();									// start fresh line
			gotChar = 1, goto gl;
			
gl_bs:		if INLEND_MIN then gl_ignore;
			directByte = BACKSPACE, outChar(from_microcode);	// ECHO
			InlEnd <= dec, goto gl_write0;
			
gl_cr:		writeCore(InlEnd, CHARIN), InlEnd <= inc;
			writeCore(InlEnd, zero);
			//dump_input();
			outCRLF();
			gotChar = 1, BP <= Inline_start, goto fetch;	

gl_tab:		if INLEND_MAX then gl_ignore;
gl_tabloop:	if AT_TAB then gl_write0;
			directByte = ' ', outChar(from_microcode);			// replace tab with spaces (and update tab counter to make AT_TAB condition work)
			directByte = ' ', writeCore(InlEnd, from_microcode), InlEnd <= inc;
			goto gl_tabloop;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2A;									// IL (insert Basic line)
			////////////////////////////////////////////////////////////////////////////////
			traceString 40;								// Trace mnemonic
			alu <= S_fromStack, ExpStack <= pop2;		// keep new line number in S
			alu <= S_plus_R;							// test line number
			T <= from_YLo, if Y_SIGN then SYNTAX_ERR;	// error if line number is negative
			Lino <= T, if Y_ZERO then SYNTAX_ERR;		// error if zero line number, if all good Lino <= S (picked up from stack)
			//traceALU();
			
			skipSpaces();								// BP now points to first char of the new Basic line in input buffer
			T <= BP;
il_findBE:	BE <= T, readCore(T);
			directByte = CR, if MDR_MATCHES_DB then il_fork;// input line text is between BP and BE inclusive
			T <= inc, goto il_findBE;
			
il_fork:	scanProgram();								// find LS, LE, number of same or first higher line number in R (or zero if neither found)
			if IMPLINE_EMPTY then next else changeLine;

deleteLine:	if R_IS_ZERO then WarmStart;				// bail if no line found at all
			if Y_ZERO then next else WarmStart;			// bail if no exact line number found
			findPrgEnd();
			copyCore(copy_init_del);					// R (dest) = LS, S (source) = LE + 1, Y (count) = PrgEnd - LE
			goto WarmStart;
			
changeLine:	if R_IS_ZERO then appendLine;				// didn't find line >= Lino in whole program, means this is append
			if Y_ZERO then next else insertLine;

replaceLine:findPrgEnd();								// implement replace as first delete the line and then insert before next higher
			copyCore(copy_init_del);					// R (dest) = LS, S (source) = LE + 1, Y (count) = PrgEnd - LE
			scanProgram();
insertLine:	findPrgEnd();
			copyCore(copy_init_ins);					// R (dest) = PrgEnd + BE - BS + 3, S (source) = PrgEnd, Y (count) = PrgEnd - LS + 1
ins_finish: copyLine(LS);
			goto WarmStart;

appendLine:	T <= dec;
			copyLine(dec);
			write2Nulls(same);
			goto WarmStart;
			
copyLine:	alu <= S_fromLino;							// go back two to overwrite the first NULL char too
			writeCore(T, from_SHi);						// Line number in binary, MSB first
			T <= inc;
			writeCore(T, from_SLo);						// Line number in binary, LSB last
			T <= inc;
app_loop:	readCore(BP);								// copy from input buffer
			writeCore(T, same);							// to Basic program area
			BP <= inc, T <= inc, directByte = CR, if MDR_MATCHES_DB then return else app_loop;
					
findPrgEnd:	T <= Prog_start;
fpe_loop:	readCore16(reset1, same);
			if R_IS_ZERO then next else fpe_next;
			T <= dec;									// PrgEnd points to 2nd NULL byte
			PrgEnd <= T, back;
fpe_next:	findNextCR(same);
			T <= inc, goto fpe_loop;
			
			// Scan through program text to find line equal (or first greater than Lino)
			// if found, its start and end are in LS and LE
scanProgram:T <= zero;
			LS <= T, LE <= T, T <= Prog_start;
			
scan_loop:  LS <= T, readCore16(reset1, same);						// assume this will be LS (LE also needed to make it "found")
			alu <= S_fromLino, if R_IS_ZERO then return;	// found end of Basic program (2 NULLs)?
scan_check:	alu <= S_minus_R;								// Lino - current line, T at first character of the Basic statement text
			//traceALU();
			if Y_ZERO then scan_found else next; 
			if Y_SIGN then scan_found else next;			// we care only about same or higher
scan_next:	findNextCR(same);								// skip to end of current line
scan_line:	T <= inc, goto scan_loop;						// scan next line

scan_found:	findNextCR(same);
			LE <= T;
			//if EXTERNAL then continue else repeat;	// DEBUG!
			back;										// LE to last char of found statement
		
			//--- copy Y bytes in Core memory from S to R ---
copyCore:	T <= from_S, if Y_ZERO then return;			// bail if no bytes left to copy
			readCore(T);
			T <= from_R;
			writeCore(T, same);
			//traceALU();
			alu <= copy_next, goto copyCore;	// Y--, R and S incremented / decremented based on direction

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2B;									// MT (Mark the BASIC program space Empty)
			////////////////////////////////////////////////////////////////////////////////
			traceString 43;								// Trace mnemonic
			goto ColdStart;

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2C;									// XQ (Start Execute)
			////////////////////////////////////////////////////////////////////////////////
			traceString 42;								// Trace mnemonic
			T <= IL_PC;									// store this location to XQhere
			XQhere <= T, readCore16(reset1, Prog_start);		// XQhere <= IL_PC, find line number of first statement
			BP <= T, T <= from_R, if R_IS_ZERO then NOPROG_ERR;	// BP at text of first line, T contains its statement number
			Lino <= T, goto fetch; 						// Lino is set to line number of first program statement			

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2D;									// WS (Stop Execute)
			////////////////////////////////////////////////////////////////////////////////
			traceString 44;								// Trace mnemonic
stop_run:	directByte = 'S', outChar(from_microcode);
			directByte = 'T', outChar(from_microcode);
			directByte = 'O', outChar(from_microcode);
			directByte = 'P', outChar(from_microcode);
			goto print_lino;									

			////////////////////////////////////////////////////////////////////////////////
			.map 0x2E;									// US (USR function call)
			////////////////////////////////////////////////////////////////////////////////
			traceString 49;								// Trace mnemonic
			alu <= R_fromStack, ExpStack <= pop2;		// R == param2
			T <= ExpStack, ExpStack <= pop2;			// T == param1 (Core address for PEEK and POKE)
			alu <= S_fromStack, ExpStack <= pop2;		// S == function index
			//traceALU();
			// TODO: better / faster "switch" implementation?
			directByte = 30, if S_EQU_DB_MOD32 then u_getarray;	// get @(index)
			directByte = 31, if S_EQU_DB_MOD32 then u_setarray;	// @(index) = value	

			directByte = 20, if S_EQU_DB_MOD32 then u_peek8;
			directByte = 21, if S_EQU_DB_MOD32 then u_peek16;
			directByte = 22, if S_EQU_DB_MOD32 then u_peek32;
			directByte = 23, if S_EQU_DB_MOD32 then u_charin;
			directByte = 24, if S_EQU_DB_MOD32 then u_poke8;
			directByte = 25, if S_EQU_DB_MOD32 then u_poke16;
			directByte = 26, if S_EQU_DB_MOD32 then u_poke32;
			directByte = 27, if S_EQU_DB_MOD32 then u_modulo;	// modulo operator
			directByte = 28, if S_EQU_DB_MOD32 then u_charout;
			directByte = 29, if S_EQU_DB_MOD32 then u_size;		// size function		
			T <= binop, goto u_done;				// by default, execute binary operation T(x) <= S(2) xor ((S(1) xor T) nor (S(0) xor R))

u_modulo: 	alu <= S_fromT, div_mod();
			T <= from_YHi, goto u_done;
			
u_charout:	alu <= S_fromT;
			MDR <= from_SLo, traceString 51;
			outChar(from_MDR);
			ExpStack <= push_TWord, goto fetch1;

u_charin:	if CHARIN_READY then next else repeat;		// wait for input character
			gotChar = 1, MDR <= CHARIN, goto u_in;

u_peek8: 	readCore(T);								// MDR <= Core(T)
u_in:		T <= MDR, goto u_done;

u_size:		T <= fromSize, goto u_done;					//TODO: proper SIZE calculation
			
u_getarray: T <= index2address, if IS_CPU32 then u_peek32;
u_peek16:	readCore16(reset0, same);
			T <= from_R, goto u_done;
u_peek32:	readCore16(reset0, same);
			readCore16(nop, same);
			T <= from_R, goto u_done;

u_poke8:	prepWrite();
			writeCore(T, from_SLo);
			goto fetch1;						
			
u_setarray: T <= index2address, if IS_CPU32 then u_poke32;	// index calculation (2 or 4 byte offset) already done by hardware
u_poke16:	prepWrite();
			T <= inc, writeS16(); 
			goto fetch1;

u_poke32:	prepWrite();
			T <= inc;
			T <= inc;
			T <= inc, writeS16();
			alu <= S_swap32, writeS16();
			goto fetch1;
				
prepWrite:	T <= save, traceString 51;				// will need the IO or memory address
			T <= from_R;							// get data to be written
			ExpStack <= push_TWord, alu <= S_fromT, T <= recall, back;	// copy to S and get target address back to T, push R (result) to stack
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0x2F;									// RT (IL subroutine return)
			////////////////////////////////////////////////////////////////////////////////
			traceString 19;								// Trace mnemonic
			if STACK_IS_EMPTY then RSTACK_ERR;
			IL_PC <= RetStack, RetStack <= pop, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b00110???;							// JS (IL subroutine call, 0x3000..0x37FF)
			////////////////////////////////////////////////////////////////////////////////
			traceString 20;								// Trace mnemonic
			traceString 3;
			if STACK_IS_FULL then RSTACK_ERR;
			RetStack <= push_IL_PC_PLUS_1, goto jump;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b00111???;							// J (Jump, 0x3800..0x3FF)		
			////////////////////////////////////////////////////////////////////////////////
			traceString 21;								// Trace mnemonic
			traceString 3;								// trace lower 8-bits of destination
jump:		IL_PC <= direct11, goto fetch;			
			
			////////////////////////////////////////////////////////////////////////////////
			.map 0b01??????;							// BR (relative branch, 0x40..0x7F)
			////////////////////////////////////////////////////////////////////////////////
			traceString 7;								// Trace mnemonic
			IL_PC <= pc_plus_off6;						// jump destination (+/- 31 locations)
br_exit:	traceGoto;									// trace target
			goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b01100000;							// BR (relative branch with 0 offset)
			////////////////////////////////////////////////////////////////////////////////
			traceString 7;								// Trace mnemonic
			goto badop;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b100?????; 							// BC a "xxx"   (80xxxxXx-9FxxxxXx  String Match Branch)
			////////////////////////////////////////////////////////////////////////////////
			traceString 17;								// Trace mnemonic
			T <= IL_PC, BP <= save, skipSpaces();
bc_loop:	traceString 3;								// trace value of IL(IL_PC) (char we try to match)
			readCore(BP);
			if MDR_MATCHES_ILCODEBYTE then next else bc_exit;
			BP <= inc, IL_PC <= inc, if ILCODEBYTE_BIT7 then next else bc_loop;
			//traceBP();
			goto fetch;
bc_exit:	BP <= recall, IL_PC <= T; 					// not found, restore BP and IL_PC
			//traceBP();
			IL_PC <= pc_plus_off5, if OFF_IS_ZERO then SYNTAX_ERR else br_exit;
					
			////////////////////////////////////////////////////////////////////////////////
			.map 0b101?????;							// BV (Branch if not variable, 0xA0..0xBF)
			////////////////////////////////////////////////////////////////////////////////
			traceString 16;								// Trace mnemonic
			skipSpaces();
			MDR <= ToUpper, if MDR_IS_ALPHA then bv_exec;	// test covers lowercase too, so can execute conversion and check in parallel	
			IL_PC <= pc_plus_off5, if OFF_IS_ZERO then SYNTAX_ERR else br_exit;		// jump destination (+ 31 locations)
bv_exec:	T <= MDRx2, if STACK_IS_FULL then ESTACK_ERR;
			ExpStack <= push_TByte, BP <= inc, goto fetch;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b110?????;							// BN (Branch if not a number, 0xC0..0xDF)
			////////////////////////////////////////////////////////////////////////////////
			traceString 14;								// Trace mnemonic
			skipSpaces();
			alu <= reset0, if MDR_IS_NUM then bn_loop;			// MDR was already loaded by skipSpaces()
			IL_PC <= pc_plus_off5, if OFF_IS_ZERO then badop;	// jump destination (+ 31 locations)
bn_exit:	traceY();											// trace integer parse result
			traceGoto;											// trace target
			goto fetch;
bn_loop:	alu <= Yx10_plus_MDR, BP <= inc;
			if ALU_OVERFLOW then OVERFLOW_ERR;
			readCore(BP);
			if MDR_IS_NUM then bn_loop;
			T <= from_YLo, if STACK_IS_FULL then ESTACK_ERR;
			ExpStack <= push_TWord, goto bn_exit;

			////////////////////////////////////////////////////////////////////////////////
			.map 0b111?????;							// BE (Branch if not endline, 0xE0..0xFF)
			////////////////////////////////////////////////////////////////////////////////
			traceString 13;								// Trace mnemonic
			skipSpaces();
			directByte = CR, if MDR_MATCHES_DB then fetch;	// found a CR, continue with next IL instruction
			IL_PC <= pc_plus_off5, if OFF_IS_ZERO then SYNTAX_ERR else br_exit;		// jump destination (+ 31 locations)
			
BREAK:		gotChar = 1, traceString 55;
			outBeep();
			directByte = 'B', outChar(from_microcode);
			directByte = 'R', outChar(from_microcode);
			directByte = 'K', outChar(from_microcode);
			goto traceDetails;
			
NOPROG_ERR:		traceString 50;
				goto traceError;
DIVBY0_ERR:		traceString 57;
				goto traceError;
OVERFLOW_ERR:	traceString 58;
				goto traceError;
SYNTAX_ERR:		traceString 61; 
				goto traceError;
INTERNAL_ERR: 	traceString 62; 
				goto traceError;
ESTACK_ERR:		traceString 60; 
				goto traceError;
RSTACK_ERR:		traceString 59;
				goto traceError;
BSTACK_ERR:		traceString 54;
traceError:		outBeep();
				directByte = 'E', outChar(from_microcode);
				directByte = 'R', outChar(from_microcode);
				directByte = 'R', outChar(from_microcode);
traceDetails:	directByte = '#', outChar(from_microcode), T <= IL_PC;
				T <= dec;				// IL_PC is already on next instruction, so go back one for correctness
				printDecR(R_fromT);
				if IS_RUNMODE then next else err_done;
print_lino:		directByte = ' ', outChar(from_microcode), alu <= S_fromLino;
				directByte = 'A', outChar(from_microcode), T <= from_S;
				directByte = 'T', outChar(from_microcode), LS <= T;
				directByte = ' ', outChar(from_microcode), T <= LS;
				printDecR(R_fromT);
				directByte = ' ', outChar(from_microcode), T <= fromTicks;	// load count of ticks (s) while Basic program was running
				printDecR(R_fromT);
				directByte = '.', outChar(from_microcode), T <= recall;		// T shadow was loaded with ms count of ticks
				printDecR(R_fromT);
err_done:		outCRLF();
				trace(crlf);
				clear, goto WarmStart2;

findNextCR: readCore(T);
			directByte = CR, if MDR_MATCHES_DB then return;										// return with T pointing to CR
			T <= inc, directByte = NULL, if MDR_MATCHES_DB then INTERNAL_ERR else findNextCR;	// finding NULL before CR is unexpected, TODO "code corruption error"?

readCore16:	readCore(T);
			alu <= Rx256_plus_MDR, T <= inc;
			readCore(T);
			alu <= Rx256_plus_MDR, T <= inc, back;				// return with T pointing to first char after the 16-bit word

write2Nulls:writeCore(T, zero), T <= inc;
			MAR <= T, MDR <= zero, goto writeCore;									// return with T pointing to last NULL! 
			
			// get 2 parameters from top of evaluation stack into ALU input registers R and S
pullRS:		if STACK_IS_EMPTY then ESTACK_ERR;
			alu <= R_fromStack, ExpStack <= pop2;
			if STACK_IS_EMPTY then ESTACK_ERR;
			alu <= S_fromStack, ExpStack <= pop2, back;
			
			// print signed 16-bit number on top of evaluation stack
printDec:	alu <= R_fromStack, ExpStack <= pop2;
			// or print it directly from R register
printDecR:	alu <= bcd_start; 
			alu <= bcd_next, if ALU_READY then next else repeat;	// repeat 16 times for each bit in R 
			if ALU_SIGN then next else printY;
			directByte = '-', outChar(from_microcode); 		// print minus sign
printY:		directByte = 6, T <= from_microcode, if IS_CPU32 then next else printY1;	// total of 8 chars for 16-bit mode
 			directByte = 14, T <= from_microcode;						// total of 16 chars for 32-bit mode
printY1:	outNZChar(from_YtoAlphaZ);		
printYlp:	outNZChar(from_YtoAlphaZ), T <= dec;
			alu <= R_fromT;
			if R_IS_ZERO then next else printYlp;
			CHAROUT <= from_YtoAlpha, goto outChar;			// saving 1 microinstruction here...

outNZChar:	outChar(from_YtoAlphaZ);
			alu <= Yx16, back;
				
skipSpaces: readCore(BP);
			directByte = ' ', if MDR_MATCHES_DB then skipSp;
			directByte = TAB, if MDR_MATCHES_DB then skipSp else return;		
skipSp:		BP <= inc, goto skipSpaces;			

outBeep:	outCRLF();
			trace(crlf);
			directByte = BEEP, CHAROUT <= from_microcode, goto outChar;
			
outCRLF:	directByte = CR, outChar(from_microcode);		
			directByte = LF, CHAROUT <= from_microcode;		// use the old fall-through trick to save time and space
outChar:	if CHAROUT_READY then next else repeat;			// sync with baudrate clock
			if CHAROUT_READY then return else repeat;

writeS16:	writeCore(T, from_SLo), T <= dec;
			MAR <= T, MDR <= from_SHi, T <= dec;
writeCore:	nWR = 0;
			nWR = 0, if nBUSACK then repeat else return;

readCore:	nRD = 0;
			nRD = 0, MDR <= from_Bus, if nBUSACK then repeat else return;

// 	Debug related subroutines
//	---------------------------------------------------------------------------		
//dump_input: InlEnd <= InLine_start, trace(crlf);
//dump_inlp:	readCore(InlEnd);
//			directByte = 9, trace(from_microcode);		// display memory byte as Hex
//			directByte = NULL, if MDR_MATCHES_DB then dump_inex;
//			InlEnd <= inc, goto dump_inlp; 
//dump_inex:	trace(crlf);
//			back;			
			
traceBP:	ExpStack <= push_TWord, T <= BP, traceString 33;
			T <= ExpStack, ExpStack <= pop2, back;

traceY:		ExpStack <= push_TWord, T <= from_YLo, traceString 32;
			T <= ExpStack, ExpStack <= pop2, back;
			
traceALU:	trace(crlf);
			T <= save, traceT;
			T <= from_S, traceString 52;
			T <= from_R, traceString 52;
			T <= from_YHi, traceString 53;		// this traces 32 bits, YHi and YLo
			T <= from_YLo, traceString 52;		
			T <= recall, DBGINDEX <= crlf;		
trace:		if DBG_READY then next else repeat;	// sync with baudrate clock that drives UART
			if DBG_READY then next else repeat;
			DBGINDEX <= zero, back;				// clear the serial debug output register and return
					
//dump_il:	directByte = 1, trace(from_microcode);		// display current IL and header to ROM
//			trace(crlf);
//			T <= IL_PC, IL_PC <= zero; 	// save IL and set to 0 to cover the ROM
//dump_il_lp:	if IL_A_VALID then next else dump_il_ex;
//			directByte = 2, trace(from_microcode);
//			directByte = 3, trace(from_microcode);
//			trace(crlf);
//			IL_PC <= inc, goto dump_il_lp; 
//dump_il_ex:	IL_PC <= T, back;	// restore IL and return
